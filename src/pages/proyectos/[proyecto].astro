---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import GaleriaDruse from '../../components/GaleriaDruse.astro';
import GaleriaFinanzas from '../../components/GaleriaFinanzas.astro';
import ArquitecturaR3Safety from '../../components/ArquitecturaR3Safety.astro';
import { perfil } from '../../data/perfil';
import { proyectos } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((proyecto) => ({
    params: { proyecto: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const inicio = import.meta.env.BASE_URL;
---

<Base title={proyecto.nombre + ' · ' + perfil.nombre} description={proyecto.resumen}>
  <Cabecera esInicio={false} />
  <main class="wrap project-page" id="contenido" tabindex="-1">
    <a class="back" href={inicio + '#trabajo'}><span aria-hidden="true">←</span> Todos los proyectos</a>

    <div class="intro">
      <div>
        <p class="category">{proyecto.categoria}</p>
        <h1>{proyecto.nombre}</h1>
        <p class="lead">{proyecto.resumen}</p>
        <ul class="tags" aria-label="Tecnologías">
          {proyecto.tecnologias.map((tecnologia) => <li class="tag">{tecnologia}</li>)}
        </ul>
        <div class="actions">
          {proyecto.enlaces.map((enlace, indice) => (
            <a class:list={['btn', { primary: indice === 0 }]} href={enlace.href}>
              {enlace.texto}{enlace.externo && <span aria-hidden="true">↗</span>}
            </a>
          ))}
        </div>
      </div>

      <div class="contribution">
        <h2>Qué construí</h2>
        {proyecto.descripcion.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </div>

    <section class="details">
      <h2>{proyecto.id === 'r3safety' ? 'Flujo y arquitectura' : 'Capturas del producto'}</h2>
      <div class="media">
        {proyecto.id === 'druse' && <GaleriaDruse />}
        {proyecto.id === 'finanzas' && <GaleriaFinanzas />}
        {proyecto.id === 'r3safety' && (
          <>
            <ol class="steps" aria-label="Flujo de trabajo">
              <li><strong>Autoevaluación</strong><span>Revisar el checklist anual.</span></li>
              <li><strong>Evidencias</strong><span>Adjuntar soportes de la revisión.</span></li>
              <li><strong>Plan de mejora</strong><span>Organizar las acciones y su seguimiento.</span></li>
            </ol>
            <ArquitecturaR3Safety />
          </>
        )}
      </div>
    </section>

    {proyecto.cifras && (
      <dl class="stats" aria-label="Datos del proyecto">
        {proyecto.cifras.map(({ texto, valor }) => (
          <div><dt>{texto}</dt><dd>{valor}</dd></div>
        ))}
      </dl>
    )}
  </main>
</Base>

<style>
  .project-page {
    padding-block: clamp(28px, 5vw, 60px) 64px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .intro {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(20px, 5vw, 72px);
    align-items: start;
    margin-top: 18px;
  }
  .category {
    color: var(--accent);
    font: 500 13px/1.45 var(--mono);
  }
  h1 {
    margin-top: 6px;
    font-size: clamp(38px, 6vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  .lead {
    margin-top: 14px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
  }
  .tags {
    list-style: none;
    padding: 0;
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .contribution {
    padding: clamp(16px, 3vw, 26px);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .contribution h2 {
    font-size: 20px;
  }
  .contribution p {
    margin-top: 10px;
    color: var(--muted);
    line-height: 1.55;
  }
  .details {
    padding-block: clamp(26px, 5vw, 48px) 0;
  }
  .details h2 {
    margin-bottom: 12px;
    font-size: clamp(22px, 3vw, 30px);
  }
  .media {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--raised);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: clamp(14px, 3vw, 26px) clamp(14px, 3vw, 26px) 0;
    list-style-position: inside;
  }
  .steps li {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .steps li::marker {
    color: var(--accent);
  }
  .steps span {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    color: var(--muted);
    font-size: 14px;
  }
  .stats dd {
    margin: 0;
    color: var(--accent);
    font-size: 21px;
    font-weight: 620;
  }

  @media (max-width: 740px) {
    .intro,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
