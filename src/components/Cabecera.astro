---
import { perfil } from '../data/perfil';

interface Props {
  esInicio?: boolean;
}
const { esInicio = true } = Astro.props;
const prefijo = esInicio ? '' : import.meta.env.BASE_URL;

const secciones = [
  { href: '#trabajo', texto: 'Proyectos' },
  { href: '#experiencia', texto: 'Experiencia' },
  { href: '#habilidades', texto: 'Habilidades' },
];
---

<header class="top">
  <div class="wrap bar">
    <a class="logo" href={prefijo + '#inicio'}>{perfil.nombreCorto}</a>
    <nav class="menu" aria-label="Principal">
      {secciones.map(({ href, texto }) => <a href={prefijo + href}>{texto}</a>)}
    </nav>
    <div class="right">
      <button class="theme" type="button" id="tema" aria-label="Cambiar entre tema claro y oscuro">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
      </button>
      <a class="btn small" href={prefijo + '#contacto'}>Contactar</a>
      <details class="mobile-menu">
        <summary aria-label="Menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h14"></path></svg>
        </summary>
        <nav class="mobile-links" aria-label="Principal">
          {secciones.map(({ href, texto }) => <a href={prefijo + href}>{texto}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const boton = document.getElementById('tema');
  boton?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const nuevo = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {
      // Sin almacenamiento el tema dura lo que dure la visita.
    }
  });

  const menuMovil = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menuMovil) {
    menuMovil.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && menuMovil.open) {
        menuMovil.open = false;
        menuMovil.querySelector('summary')?.focus();
      }
    });

    document.addEventListener('click', (evento) => {
      const destino = evento.target;
      if (menuMovil.open && destino instanceof Element && (!menuMovil.contains(destino) || destino.closest('a'))) {
        menuMovil.open = false;
      }
    });
  }
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s ease;
  }
  .top.is-scrolled {
    box-shadow: 0 8px 24px -16px rgba(0, 0, 0, 0.25);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    gap: 16px;
  }
  .logo {
    font-weight: 600;
    text-decoration: none;
  }
  .menu {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }
  .menu a {
    text-decoration: none;
    color: var(--muted);
  }
  .menu a:hover {
    color: var(--ink);
  }
  .right {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .theme,
  .mobile-menu summary {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme svg {
    width: 16px;
    height: 16px;
  }
  .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: block;
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu summary {
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .mobile-menu summary svg {
    width: 20px;
    height: 20px;
  }
  .mobile-menu[open] summary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .mobile-links {
    position: absolute;
    inset-block-start: calc(100% + 8px);
    inset-inline-end: 0;
    min-width: 200px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    border-radius: 8px;
    font-size: 15px;
    text-decoration: none;
  }
  .mobile-links a:hover,
  .mobile-links a:focus-visible {
    background: var(--raised);
  }
  @media (max-width: 680px) {
    .menu {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .bar {
      gap: 6px;
    }
    .logo {
      font-size: 15px;
    }
    .right {
      flex-shrink: 0;
      gap: 4px;
    }
    .theme,
    .mobile-menu summary {
      width: 40px;
      height: 44px;
    }
    .right .btn {
      height: 44px;
      padding-inline: 8px;
    }
  }
</style>
