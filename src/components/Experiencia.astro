---
import { experiencia, formacion, habilidades } from '../data/perfil';
---

<section id="experiencia" class="wrap">
  <div class="sec-title">
    <div><span class="eyebrow">Experiencia</span><h2>Dónde he trabajado</h2></div>
  </div>
  <div class="jobs">
    {experiencia.map((e) => (
      <div class="job">
        <div class="co">{e.empresa}{e.detalle && <small>{e.detalle}</small>}</div>
        <div>
          <h3>{e.cargo}</h3>
          <p>{e.resumen}</p>
        </div>
        <span class="when">{e.periodo}</span>
      </div>
    ))}
  </div>
</section>

<section id="habilidades" class="wrap">
  <div class="sec-title">
    <div><span class="eyebrow">Habilidades</span><h2>Con qué trabajo</h2></div>
  </div>
  <div class="skills">
    {habilidades.map((h) => (
      <div>
        <h3>{h.grupo}</h3>
        <ul>{h.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
  </div>
  <div class="edu">
    {formacion.map((f) => (
      <div><b>{f.titulo}</b><span>{f.lugar}</span></div>
    ))}
  </div>
</section>

<style>
  .jobs {
    border-top: 1px solid var(--line);
  }
  .job {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 8px 32px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .job > * {
    min-width: 0;
  }
  .co {
    font-weight: 600;
  }
  .co small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 13.5px;
    margin-top: 2px;
  }
  .job h3 {
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .job p {
    color: var(--muted);
    margin-top: 6px;
    font-size: 15px;
    max-width: 62ch;
  }
  .when {
    font: 400 13px var(--mono);
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .skills > div {
    background: var(--surface);
    padding: 24px;
    min-width: 0;
  }
  .skills h3 {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0;
  }
  .skills ul {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    gap: 8px;
    font-size: 15px;
  }
  .edu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  .edu > div {
    min-width: 0;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .edu b {
    display: block;
    font-weight: 500;
  }
  .edu span {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
    .edu {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .when {
      order: -1;
    }
  }
  @media (max-width: 620px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
