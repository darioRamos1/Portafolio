---
import { Image } from 'astro:assets';
import foto from '../assets/foto.png';
import relaciones from '../assets/proyectos/druse-relaciones.jpg';
import { perfil } from '../data/perfil';
---

<div class="hero wrap" id="inicio">
  <div class="hero-copy">
    <div class="identity">
      <Image class="avatar" src={foto} alt="" width={112} loading="eager" />
      <div>
        <p class="name">{perfil.nombre}</p>
        {perfil.disponible && <p class="status"><span aria-hidden="true"></span>Disponible para nuevos roles</p>}
      </div>
    </div>

    <h1>{perfil.rol}</h1>
    <p class="stack">{perfil.stack}</p>
    <p class="lead">{perfil.presentacion}</p>

    <div class="actions">
      <a class="btn primary" href="#trabajo">Ver proyectos <span aria-hidden="true">↓</span></a>
      <a class="btn" href={perfil.cv} download>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v8m0 0 3-3m-3 3L5 7M3 13h10"></path></svg>
        Descargar CV
      </a>
    </div>

    <a class="experience-note" href="#experiencia">
      <span>
        <strong>DataTools</strong>
        <span>Migré proyectos de SAEPS a .NET 9 y trabajé en transporte público y notificaciones para Fénix.</span>
      </span>
      <span class="arrow" aria-hidden="true">↘</span>
    </a>
  </div>

  <a class="featured" href={import.meta.env.BASE_URL + 'proyectos/druse/'}>
    <div class="featured-art">
      <div class="featured-window">
        <Image
          src={relaciones}
          alt=""
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 620px) 100vw, (max-width: 820px) 620px, 560px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="featured-caption">
      <div>
        <p class="featured-title">Druse</p>
        <p class="featured-description">Diagramas de relaciones en un cliente SQL de código abierto</p>
      </div>
      <span class="featured-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</div>

<style>
  .hero {
    padding-block: clamp(36px, 6.6vw, 86px) clamp(28px, 5vw, 60px);
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    object-position: 50% 25%;
    border: 1px solid var(--line);
    background: #fff;
  }
  .name {
    font-weight: 650;
    line-height: 1.4;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .status span {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 17%, transparent);
  }
  h1 {
    font-size: clamp(38px, 4.9vw, 65px);
    line-height: 1.03;
    margin-top: 22px;
    letter-spacing: -0.055em;
    max-width: 16ch;
  }
  .stack {
    color: var(--accent);
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 570;
    letter-spacing: -0.025em;
    margin-top: 8px;
  }
  .lead {
    font-size: clamp(16px, 1.6vw, 18px);
    color: var(--muted);
    max-width: 47ch;
    margin-top: 12px;
    line-height: 1.55;
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .experience-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 14px;
    margin-top: 22px;
    max-width: 46ch;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.48;
    text-decoration: none;
  }
  .experience-note:hover {
    border-color: var(--accent);
  }
  .experience-note strong {
    display: block;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .arrow {
    color: var(--accent);
    flex: none;
  }
  .featured {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .featured:hover {
    border-color: var(--accent);
  }
  .featured-art {
    padding: clamp(14px, 2.5vw, 28px);
    background: radial-gradient(ellipse at 65% 0%, color-mix(in srgb, var(--accent) 26%, var(--raised)), var(--raised) 80%);
  }
  .featured-window {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid #393f51;
    aspect-ratio: 1.65;
    background: #15171f;
  }
  .featured-window img {
    position: absolute;
    inset: 0 0 0 -14%;
    width: 128%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
  .featured-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px clamp(14px, 2.5vw, 28px);
    border-top: 1px solid var(--line);
  }
  .featured-title {
    font-size: 19px;
    font-weight: 650;
  }
  .featured-description {
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
  .featured-arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .featured {
      width: min(100%, 560px);
    }
  }
  @media (max-width: 380px) {
    .actions .btn {
      padding-inline: 12px;
    }
  }
</style>
