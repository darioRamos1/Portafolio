---
import { Image } from 'astro:assets';
import foto from '../assets/foto.png';
import { perfil } from '../data/perfil';
---

<div class="hero wrap" id="inicio">
  <Image class="avatar" src={foto} alt={`Foto de ${perfil.nombre}`} width={224} loading="eager" />
  <div>
    {perfil.disponible && <span class="status"><i></i>Disponible para nuevos proyectos</span>}
    <h1>{perfil.rol}.<br /><em>{perfil.stack}.</em></h1>
    <p class="lead">{perfil.presentacion}</p>
    <div class="actions">
      <a class="btn primary" href="#trabajo">Ver mi trabajo</a>
      <a class="btn" href={perfil.cv} download>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v8m0 0 3-3m-3 3L5 7M3 13h10"></path></svg>
        Descargar CV
      </a>
    </div>
    <div class="meta">
      {perfil.cifras.map((c) => <span>{c.valor && <b>{c.valor}</b>} {c.texto}</span>)}
    </div>
  </div>
</div>

<style>
  .hero {
    padding-block: 88px 72px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px 40px;
    align-items: start;
  }
  .hero > * {
    min-width: 0;
  }
  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 24px;
    object-fit: cover;
    object-position: 50% 25%;
    border: 1px solid var(--line);
    background: #fff;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 12px 5px 10px;
    background: var(--surface);
  }
  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 20%, transparent);
  }
  h1 {
    font-size: clamp(38px, 6.2vw, 68px);
    line-height: 1.02;
    margin-top: 18px;
    letter-spacing: -0.04em;
  }
  h1 em {
    font-style: normal;
    color: var(--muted);
  }
  .lead {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
    max-width: 56ch;
    margin-top: 22px;
    line-height: 1.55;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .meta b {
    color: var(--ink);
    font-weight: 500;
  }
  @media (max-width: 620px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
    }
    .avatar {
      width: 88px;
      height: 88px;
      border-radius: 20px;
    }
  }
</style>
