---
import { perfil } from '../data/perfil';
---

<div class="contact wrap" id="contacto">
  <span class="eyebrow">Contacto</span>
  <h2>¿Tienes un proyecto en mente?</h2>
  <p>Estoy abierto a roles de backend .NET o full stack, en remoto o en Valledupar.</p>
  <div class="mailrow">
    <a class="mail" href={`mailto:${perfil.email}`} id="correo">{perfil.email}</a>
    <button class="btn small" type="button" id="copiar">Copiar</button>
  </div>
  <div class="socials">
    <a href={perfil.linkedin} rel="me">LinkedIn ↗</a>
    <a href={perfil.github} rel="me">GitHub ↗</a>
    <a href={perfil.cv} download>CV en PDF ↗</a>
  </div>
</div>

<footer class="wrap">
  <span>© {new Date().getFullYear()} {perfil.nombre}</span>
  <span>{perfil.ciudad}</span>
</footer>

<script>
  const copiar = document.getElementById('copiar');
  copiar?.addEventListener('click', async () => {
    const correo = document.getElementById('correo')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(correo);
      copiar.textContent = 'Copiado';
      setTimeout(() => (copiar.textContent = 'Copiar'), 1600);
    } catch {
      // Sin portapapeles, se selecciona el texto para copiarlo a mano.
      const rango = document.createRange();
      rango.selectNodeContents(document.getElementById('correo')!);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(rango);
    }
  });
</script>

<style>
  .contact {
    padding-block: 96px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(34px, 5.4vw, 60px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    max-width: 16ch;
    margin-top: 12px;
  }
  p {
    color: var(--muted);
    margin-top: 18px;
    max-width: 52ch;
    font-size: 18px;
  }
  .mailrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
  }
  .mail {
    font: 500 clamp(17px, 2.2vw, 22px) var(--sans);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    gap: 20px;
    margin-top: 28px;
    font-size: 15px;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .socials a {
    text-decoration: none;
  }
  .socials a:hover {
    color: var(--ink);
  }
  footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    font-size: 13px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
