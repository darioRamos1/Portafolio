---
import { Image } from 'astro:assets';
import constructor from '../assets/proyectos/druse-constructor.jpg';
import finanzasInicio from '../assets/proyectos/finanzas-inicio.png';
import finanzasReportes from '../assets/proyectos/finanzas-reportes.png';
import ArquitecturaR3Safety from './ArquitecturaR3Safety.astro';
import { proyectos } from '../data/proyectos';
---

<section id="trabajo" class="wrap">
  <div class="sec-title">
    <h2>Proyectos</h2>
  </div>

  <div class="project-grid">
    {proyectos.map((proyecto) => (
      <article class="project" id={proyecto.id}>
        <div class:list={['preview', 'preview--' + proyecto.id]} aria-hidden="true">
          {proyecto.id === 'druse' && (
            <Image
              src={constructor}
              alt=""
              widths={[360, 540, 720]}
              sizes="(max-width: 740px) 25vw, (max-width: 1120px) 38vw, 440px"
              loading="lazy"
            />
          )}
          {proyecto.id === 'finanzas' && (
            <div class="phones">
              <Image src={finanzasInicio} alt="" width={210} loading="lazy" />
              <Image src={finanzasReportes} alt="" width={210} loading="lazy" />
            </div>
          )}
          {proyecto.id === 'r3safety' && <ArquitecturaR3Safety compacto />}
        </div>

        <div class="project-body">
          <p class="category">{proyecto.categoria}</p>
          <h3>
            <a href={import.meta.env.BASE_URL + 'proyectos/' + proyecto.id + '/'}>
              {proyecto.nombre}
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          </h3>
          <p class="summary">{proyecto.resumen}</p>
          <ul class="tags" aria-label="Tecnologías principales">
            {proyecto.tecnologias.slice(0, 3).map((tecnologia) => <li class="tag">{tecnologia}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  #trabajo {
    padding-block: clamp(24px, 4vw, 48px);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .project {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
  }
  .project:hover {
    border-color: var(--accent);
  }
  .project:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .preview {
    display: grid;
    place-items: center;
    position: relative;
    aspect-ratio: 2.05;
    overflow: hidden;
    background: var(--raised);
    border-bottom: 1px solid var(--line);
  }
  .preview--druse > img {
    position: absolute;
    inset: 0 0 0 -13%;
    width: 126%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center 47%;
  }
  .preview--finanzas {
    background: radial-gradient(ellipse at 50% 80%, color-mix(in srgb, #2a9270 25%, var(--raised)), var(--raised) 80%);
  }
  .phones {
    position: absolute;
    inset: 15px 0 0;
    display: flex;
    align-items: start;
    justify-content: center;
    gap: 10px;
  }
  .phones img {
    width: clamp(76px, 9vw, 110px);
    height: auto;
    border: 3px solid #263a32;
    border-radius: 13px;
    background: #263a32;
  }
  .phones img + img {
    margin-top: 14px;
  }
  .preview--r3safety {
    background: radial-gradient(ellipse at 50% 30%, color-mix(in srgb, var(--accent) 15%, var(--raised)), var(--raised) 80%);
  }
  .project-body {
    padding: 16px 18px 20px;
  }
  .category {
    color: var(--accent);
    font: 500 11.5px/1.4 var(--mono);
  }
  h3 {
    margin-top: 3px;
    font-size: 23px;
    letter-spacing: -0.035em;
  }
  h3 a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-decoration: none;
  }
  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }
  h3 a:focus-visible {
    outline: none;
  }
  .project-arrow {
    color: var(--accent);
    font-size: 18px;
  }
  .summary {
    margin-top: 4px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin-block: 14px 0;
  }

  @media (max-width: 740px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .project {
      display: grid;
      grid-template-columns: clamp(85px, 25vw, 150px) minmax(0, 1fr);
    }
    .preview {
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .preview--druse > img {
      inset-inline-start: 0;
      width: 100%;
      object-position: 58% center;
    }
    .phones {
      inset-block-start: 15px;
    }
    .phones img {
      width: min(70%, 76px);
    }
    .phones img + img {
      display: none;
    }
    .project-body {
      padding: 12px 13px 14px;
    }
    h3 {
      font-size: 20px;
    }
    .tags {
      display: none;
    }
  }
</style>
