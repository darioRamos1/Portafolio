---
import { Image } from 'astro:assets';
import inicio from '../assets/proyectos/finanzas-inicio.png';
import registrar from '../assets/proyectos/finanzas-registrar.png';
import historial from '../assets/proyectos/finanzas-historial.png';
import reportes from '../assets/proyectos/finanzas-reportes.png';
import cuentas from '../assets/proyectos/finanzas-cuentas.png';
import suscripciones from '../assets/proyectos/finanzas-suscripciones.png';

const capturas = [
  { src: inicio, nombre: 'Inicio', alt: 'Dinero disponible y pagos próximos' },
  { src: registrar, nombre: 'Registrar movimiento', alt: 'Formulario para registrar un gasto o un ingreso' },
  { src: historial, nombre: 'Historial', alt: 'Historial de movimientos recientes' },
  { src: reportes, nombre: 'Reportes', alt: 'Resumen mensual de ingresos y gastos' },
  { src: cuentas, nombre: 'Cuentas', alt: 'Saldos de las cuentas' },
  { src: suscripciones, nombre: 'Suscripciones', alt: 'Suscripciones y pagos recurrentes' },
];
---

<div class="gallery" id="capturas-finanzas" role="group" aria-label="Capturas de Druse Finanzas" data-finance-gallery>
  <ul class="stage" role="list">
    {capturas.map((c) => (
      <li class="slide" data-title={c.nombre}>
        <div class="screen">
          <Image src={c.src} alt={c.alt} widths={[180, 240, 360, 480, 720]} sizes="(max-width: 440px) 55vw, 240px" loading="lazy" />
        </div>
        <span class="slide-name">{c.nombre}</span>
      </li>
    ))}
  </ul>
  <div class="controls" hidden>
    <button type="button" data-step="-1" aria-label="Captura anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
    </button>
    <p class="caption" aria-live="polite" aria-atomic="true">
      <strong data-caption>{capturas[0].nombre}</strong>
      <span data-count>1 de {capturas.length}</span>
    </p>
    <button type="button" data-step="1" aria-label="Siguiente captura">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-finance-gallery]').forEach((galeria) => {
    const escenario = galeria.querySelector<HTMLElement>('.stage');
    const controles = galeria.querySelector<HTMLElement>('.controls');
    const titulo = galeria.querySelector<HTMLElement>('[data-caption]');
    const contador = galeria.querySelector<HTMLElement>('[data-count]');
    const capturas = galeria.querySelectorAll<HTMLElement>('.slide');
    if (!escenario || !controles || !titulo || !contador || capturas.length < 2) return;

    const total = capturas.length;
    let actual = 0;

    const mostrar = (indice: number) => {
      actual = (indice + total) % total;
      capturas.forEach((captura, i) => {
        const distancia = (i - actual + total) % total;
        captura.dataset.position = String(distancia > total / 2 ? distancia - total : distancia);
        captura.setAttribute('aria-hidden', String(i !== actual));
      });
      titulo.textContent = capturas[actual].dataset.title ?? '';
      contador.textContent = `${actual + 1} de ${total}`;
    };

    controles.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((boton) => {
      boton.addEventListener('click', () => mostrar(actual + Number(boton.dataset.step)));
    });
    controles.addEventListener('keydown', (evento) => {
      if (evento.key !== 'ArrowLeft' && evento.key !== 'ArrowRight') return;
      evento.preventDefault();
      mostrar(actual + (evento.key === 'ArrowLeft' ? -1 : 1));
    });

    let inicio: { puntero: number; x: number; y: number } | undefined;
    escenario.addEventListener('pointerdown', (evento) => {
      if (evento.pointerType === 'touch' && evento.isPrimary) {
        inicio = { puntero: evento.pointerId, x: evento.clientX, y: evento.clientY };
      }
    });
    escenario.addEventListener('pointercancel', () => { inicio = undefined; });
    escenario.addEventListener('pointerup', (evento) => {
      if (inicio?.puntero !== evento.pointerId) return;
      const dx = evento.clientX - inicio.x;
      const dy = evento.clientY - inicio.y;
      inicio = undefined;
      if (Math.abs(dx) > Math.max(40, Math.abs(dy) * 1.4)) mostrar(actual + (dx < 0 ? 1 : -1));
    });

    mostrar(0);
    galeria.dataset.ready = '';
    controles.hidden = false;
  });
</script>

<style>
  .gallery {
    --phone-width: clamp(168px, 55vw, 240px);
    --spread: clamp(77px, 26vw, 192px);
    --glow: #22876a;
    overflow: hidden;
    padding-block: 26px 22px;
    background: radial-gradient(ellipse 54% 70% at 50% 44%, color-mix(in srgb, var(--glow) 20%, transparent), transparent);
  }
  .stage {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    justify-content: safe center;
    list-style: none;
    margin: 0;
    padding: 8px 18px 20px;
  }
  .slide {
    flex: none;
    width: var(--phone-width);
    scroll-snap-align: center;
  }
  .screen {
    border: 4px solid #182420;
    border-radius: 23px;
    background: #182420;
    box-shadow: 0 18px 34px -20px rgb(0 0 0 / 55%);
    overflow: hidden;
  }
  .screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  .slide-name {
    display: block;
    margin-top: 8px;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }
  .gallery[data-ready] .stage {
    display: grid;
    place-items: center;
    perspective: 850px;
    touch-action: pan-y pinch-zoom;
    overflow: visible;
  }
  .gallery[data-ready] .slide {
    --direction: 1;
    grid-area: 1 / 1;
    transform: translateX(calc(var(--spread) * var(--direction))) translateY(15px) scale(0.81) rotateY(calc(-12deg * var(--direction)));
    opacity: 0;
    visibility: hidden;
  }
  .gallery[data-ready] .slide[data-position^='-'] {
    --direction: -1;
  }
  .gallery[data-ready] .slide[data-position='-1'],
  .gallery[data-ready] .slide[data-position='1'] {
    z-index: 1;
    opacity: 0.6;
    visibility: visible;
  }
  .gallery[data-ready] .slide[data-position='0'] {
    z-index: 2;
    transform: translateX(0) translateY(0) scale(1) rotateY(0deg);
    opacity: 1;
    visibility: visible;
  }
  .gallery[data-ready] .slide-name {
    display: none;
  }
  .controls:not([hidden]) {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 10px;
    width: min(100% - 32px, 300px);
    min-height: 58px;
    margin: 3px auto 0;
  }
  .controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
  }
  .controls button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .controls button:focus-visible {
    border-radius: 50%;
  }
  .controls svg {
    width: 20px;
    height: 20px;
  }
  .caption {
    display: grid;
    gap: 3px;
    text-align: center;
    line-height: 1.3;
  }
  .caption strong {
    font-size: 15px;
    font-weight: 600;
  }
  .caption span {
    font: 400 12px var(--mono);
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .gallery[data-ready] .slide {
      transition: transform 0.38s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.32s ease, visibility 0.32s;
    }
  }
</style>
